# GitHub token. Needs read access to repos/PRs/issues and `issues:write`
# (posting a PR review comment uses the issue-comments endpoint).
#   - Classic PAT: `repo` scope covers it.
#   - Fine-grained PAT: Contents=Read, Pull requests=Read, Issues=Read & write,
#     across the repos/org you want covered.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# API key for the `claude` CLI.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# GitHub Enterprise? Point this at your instance's API root.
# GITHUB_API=https://github.example.com/api/v3

# --- optional tuning ---------------------------------------------------------
# INCLUDE_ISSUES=1          # 0 to review PRs only
# REPOS="me/repo-a org/repo-b"   # restrict to specific owner/repo slugs
# AFFILIATION=owner,collaborator,organization_member
# MAX_DIFF_BYTES=60000      # truncate large diffs sent to the model
# DRY_RUN=1                 # print reviews instead of posting them
# CLAUDE_MODEL=claude-sonnet-4-6
